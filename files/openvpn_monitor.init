#!/bin/sh /etc/rc.common

USE_PROCD=1

start_service() {
	config_load 'openvpn'
	logger -t openvpn_monitor "Starting iteration"
	process_instance() {
		local instance="$1"
		local management
		local name
		
		logger -t openvpn_monitor "Processing instance: $instance"

		config_get management "$instance" management '0'
		config_get name "$instance" name
		config_get enabled "$instance" enable '0'

		if [ "$management" != '0' ] && [ "$enabled" != 0 ]; then
			procd_open_instance "$instance"
			procd_set_param command /usr/bin/openvpn_ubus.lua "$name" "$management"		
			logger -t openvpn_ubus "Starting service instance $name"
			procd_close_instance
		fi

	}

	config_foreach process_instance openvpn
}

service_triggers() {
	procd_add_reload_trigger 'openvpn'
}


